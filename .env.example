# Copy this file to apps/api/.env for local development.
# Never commit a real .env file or production secrets.

# development | test | production
NODE_ENV=development

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saba_tarkhis?schema=public

# API HTTP port
PORT=4000

# Exact origin of the frontend. Used for CORS and the Origin/CSRF check.
APP_ORIGIN=http://localhost:3000

# Server-side session lifetime (days, max 30)
SESSION_TTL_DAYS=7

# Private directory for uploaded documents (outside any public web root)
UPLOAD_DIR=./storage

# Private quarantine directory used while a file is being scanned
QUARANTINE_DIR=./storage-quarantine

# Maximum size of each uploaded document (MB, max 25)
MAX_UPLOAD_MB=5

# Per-case and per-account storage budgets
MAX_DOCUMENTS_PER_REQUEST=20
MAX_CASE_UPLOAD_MB=50
MAX_USER_STORAGE_MB=200

# Per-user hourly limits for creating requests and uploading files
REQUEST_CREATE_LIMIT_PER_HOUR=10
UPLOAD_LIMIT_PER_HOUR=20

# Malware scanning. Required (true) in production; install ClamAV and set the
# binary path. When disabled locally, uploads are stored without a scan.
# CLAMAV_ENABLED=true
CLAMSCAN_PATH=clamscan
CLAMSCAN_TIMEOUT_MS=20000

# Force the Secure cookie flag. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# Set true only when correctly behind a trusted reverse proxy
# (required with nginx so rate limits see the real client IP).
# TRUST_PROXY=false

# Built SPA directory served by the API (single-origin deploy). Defaults to
# ../web/dist; when it does not exist, the API runs alone.
# WEB_DIST_DIR=../web/dist

# Swagger UI at /api/docs. Defaults to on outside production and off in production.
# ENABLE_API_DOCS=false

# Used by the API test suite only
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saba_tarkhis_test?schema=public

# Frontend (optional). Leave unset to use the Vite dev proxy at /api.
# VITE_API_URL=http://localhost:4000/api/v1
