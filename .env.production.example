# Copy to .env.production (never commit it) and replace every CHANGE_ME value.
# Used by docker-compose.prod.yml for both the app and the Postgres container.

NODE_ENV=production
PORT=4000

# Public origin users see in the browser: https, exact host, no trailing slash.
# CORS, the Origin/CSRF check and Secure cookies all depend on this value.
APP_ORIGIN=https://example.com

# Postgres container credentials (POSTGRES_*) and the app connection string must
# agree. For the least-privilege split (saba_owner / saba_app) see docs/deployment.md.
POSTGRES_DB=saba_tarkhis
POSTGRES_USER=saba_owner
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://saba_owner:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/saba_tarkhis?schema=public

SESSION_TTL_DAYS=7

# Private document storage and scan quarantine. Both live on the same volume
# (`saba_tarkhis_files`) because a scanned file is moved from quarantine into
# storage — a cross-volume rename would fail.
UPLOAD_DIR=/var/lib/saba-tarkhis/storage
QUARANTINE_DIR=/var/lib/saba-tarkhis/quarantine
MAX_UPLOAD_MB=5
MAX_DOCUMENTS_PER_REQUEST=20
MAX_CASE_UPLOAD_MB=50
MAX_USER_STORAGE_MB=200
REQUEST_CREATE_LIMIT_PER_HOUR=10
UPLOAD_LIMIT_PER_HOUR=20

# Behind the TLS proxy.
COOKIE_SECURE=true
TRUST_PROXY=true
ENABLE_API_DOCS=false

# Mandatory in production (the API refuses to start without it).
CLAMAV_ENABLED=true
CLAMSCAN_PATH=/usr/bin/clamscan
CLAMSCAN_TIMEOUT_MS=20000
# How often the container refreshes virus signatures (seconds, default 6h).
# CLAMAV_UPDATE_INTERVAL_SECONDS=21600

# Built SPA served by the API (image layout). Leave as-is for Docker.
WEB_DIST_DIR=../web/dist
