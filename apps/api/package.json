{
  "name": "@saba-tarkhis/api",
  "private": true,
  "version": "1.0.0",
  "description": "Saba Tarkhis clearance request API (Express + Prisma + PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/check-env.mjs && prisma migrate dev",
    "db:deploy": "node scripts/check-env.mjs && prisma migrate deploy",
    "db:seed": "node scripts/guard-db.mjs seed && tsx prisma/seed.ts",
    "db:reset": "node scripts/guard-db.mjs reset && node scripts/check-env.mjs && prisma migrate reset --force",
    "db:studio": "prisma studio",
    "user:create": "node scripts/create-user.mjs",
    "scan:verify": "node scripts/verify-clamav.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "prisma": "^6.19.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
