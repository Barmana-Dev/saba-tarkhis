{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // The package has no "type": "module", so NodeNext still emits CommonJS.
    // "node" (node10) resolution is removed in TypeScript 7.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": ["src"]
}
