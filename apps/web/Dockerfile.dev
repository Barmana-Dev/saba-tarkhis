# Development image for the web app: dependencies are baked in, the source is
# bind-mounted by docker-compose.yml and Vite listens on all interfaces.
FROM node:24-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000", "--strictPort"]
